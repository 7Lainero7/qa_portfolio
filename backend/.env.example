POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qa_portfolio
POSTGRES_USER=postgres
# Укажите свой локальный пароль PostgreSQL (секрет не хранится в репозитории)
POSTGRES_PASSWORD=change-me
# Для тестов и CI используется отдельная база: POSTGRES_DB=qa_portfolio_test
# (подстановка через ENV имеет приоритет над этим .env-файлом)

API_KEY=test-key
# Создание БД/таблиц при старте приложения (до перехода на Alembic).
# В CI и тестах лучше выставить false — схема готовится фикстурами.
AUTO_CREATE_SCHEMA=true